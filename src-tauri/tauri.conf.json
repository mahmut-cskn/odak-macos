{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odak",
  "version": "1.5.0",
  "identifier": "com.mahmutcskn.odak",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Odak",
        "width": 850,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "visible": true
      },
      {
        "label": "quick",
        "title": "Hızlı görev ekle",
        "url": "index.html?quick=1",
        "width": 480,
        "height": 260,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Odaklan, planla, tamamla.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
